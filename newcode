 <body>
  <div class="container">
   <header class="header">
    <h1 id="app-title">Vehicle Tracker Simulator</h1>
    <div class="route-info">
     <div class="info-item"><span class="info-label">Vehicle</span> <span class="info-value" id="vehicle-name">Delivery Truck #1</span>
     </div>
     <div class="info-item"><span class="info-label">Route</span> <span class="info-value" id="route-name">Downtown Delivery Route</span>
     </div>
     <div class="info-item"><span class="info-label">Status</span> <span class="info-value" id="vehicle-status">Ready</span>
     </div>
    </div>
   </header>
   <main class="main-content">
    <div class="map-container">
     <div id="map"></div>
     <div class="controls-panel">
      <div class="controls-title">
       Simulation Controls
      </div>
      <div class="control-buttons"><button class="control-btn play-btn" id="playBtn"> ▶ Play </button> <button class="control-btn pause-btn" id="pauseBtn"> ⏸ Pause </button> <button class="control-btn reset-btn" id="resetBtn"> ⏮ Reset </button>
      </div>
      <div class="speed-control"><label class="speed-label" for="speedSlider">Speed: <span id="speedValue">1x</span></label> <input type="range" id="speedSlider" class="speed-slider" min="0.5" max="3" step="0.5" value="1">
      </div>
      <div class="status-info">
       <div class="status-item"><span class="status-label">Position:</span> <span class="status-value" id="currentPosition">0 / 0</span>
       </div>
       <div class="status-item"><span class="status-label">Coordinates:</span> <span class="status-value" id="currentCoords">---, ---</span>
       </div>
       <div class="status-item"><span class="status-label">Speed:</span> <span class="status-value" id="currentSpeed">0 km/h</span>
       </div>
       <div class="status-item"><span class="status-label">Time:</span> <span class="status-value" id="elapsedTime">00:00</span>
       </div>
      </div>
      <div class="progress-bar">
       <div class="progress-fill" id="progressFill"></div>
      </div>
     </div>
    </div>
   </main>
  </div>
  <script>
        // Default configuration
        const defaultConfig = {
            app_title: "Vehicle Tracker Simulator",
            vehicle_name: "Delivery Truck #1",
            route_name: "Downtown Delivery Route",
            primary_color: "#4299e1",
            surface_color: "#ffffff",
            text_color: "#2d3748",
            accent_color: "#48bb78",
            background_color: "#667eea"
        };

        // Dummy route data - simulating a delivery route in a city
        const routeData = [
            { "latitude": 40.7589, "longitude": -73.9851, "timestamp": "2024-07-20T10:00:00Z" },
            { "latitude": 40.7590, "longitude": -73.9850, "timestamp": "2024-07-20T10:00:05Z" },
            { "latitude": 40.7592, "longitude": -73.9848, "timestamp": "2024-07-20T10:00:10Z" },
            { "latitude": 40.7595, "longitude": -73.9845, "timestamp": "2024-07-20T10:00:15Z" },
            { "latitude": 40.7598, "longitude": -73.9842, "timestamp": "2024-07-20T10:00:20Z" },
            { "latitude": 40.7601, "longitude": -73.9840, "timestamp": "2024-07-20T10:00:25Z" },
            { "latitude": 40.7605, "longitude": -73.9838, "timestamp": "2024-07-20T10:00:30Z" },
            { "latitude": 40.7608, "longitude": -73.9835, "timestamp": "2024-07-20T10:00:35Z" },
            { "latitude": 40.7612, "longitude": -73.9832, "timestamp": "2024-07-20T10:00:40Z" },
            { "latitude": 40.7615, "longitude": -73.9830, "timestamp": "2024-07-20T10:00:45Z" },
            { "latitude": 40.7618, "longitude": -73.9827, "timestamp": "2024-07-20T10:00:50Z" },
            { "latitude": 40.7621, "longitude": -73.9825, "timestamp": "2024-07-20T10:00:55Z" },
            { "latitude": 40.7624, "longitude": -73.9822, "timestamp": "2024-07-20T10:01:00Z" },
            { "latitude": 40.7627, "longitude": -73.9820, "timestamp": "2024-07-20T10:01:05Z" },
            { "latitude": 40.7630, "longitude": -73.9818, "timestamp": "2024-07-20T10:01:10Z" },
            { "latitude": 40.7633, "longitude": -73.9815, "timestamp": "2024-07-20T10:01:15Z" },
            { "latitude": 40.7636, "longitude": -73.9813, "timestamp": "2024-07-20T10:01:20Z" },
            { "latitude": 40.7639, "longitude": -73.9810, "timestamp": "2024-07-20T10:01:25Z" },
            { "latitude": 40.7642, "longitude": -73.9808, "timestamp": "2024-07-20T10:01:30Z" },
            { "latitude": 40.7645, "longitude": -73.9805, "timestamp": "2024-07-20T10:01:35Z" }
        ];

        // Application state
        let map;
        let vehicleMarker;
        let routePolyline;
        let currentRoutePolyline;
        let currentIndex = 0;
        let isPlaying = false;
        let animationSpeed = 1;
        let startTime = null;
        let animationId = null;

        // Initialize the application
        function initializeApp() {
            initializeMap();
            setupEventListeners();
            updateUI();
        }

        // Initialize the Leaflet map
        function initializeMap() {
            // Create map centered on the first route point
            map = L.map('map').setView([routeData[0].latitude, routeData[0].longitude], 15);

            // Add OpenStreetMap tiles
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors'
            }).addTo(map);

            // Create the full route polyline (in light gray)
            const routeCoordinates = routeData.map(point => [point.latitude, point.longitude]);
            routePolyline = L.polyline(routeCoordinates, {
                color: '#cbd5e0',
                weight: 4,
                opacity: 0.7,
                dashArray: '10, 5'
            }).addTo(map);

            // Create the current route polyline (colored)
            currentRoutePolyline = L.polyline([], {
                color: '#48bb78',
                weight: 6,
                opacity: 0.9
            }).addTo(map);

            // Create vehicle marker
            const vehicleIcon = L.divIcon({
                className: 'vehicle-marker',
                iconSize: [24, 24],
                iconAnchor: [12, 12]
            });

            vehicleMarker = L.marker([routeData[0].latitude, routeData[0].longitude], {
                icon: vehicleIcon
            }).addTo(map);

            // Fit map to show the entire route
            map.fitBounds(routePolyline.getBounds(), { padding: [20, 20] });
        }

        // Setup event listeners
        function setupEventListeners() {
            document.getElementById('playBtn').addEventListener('click', startSimulation);
            document.getElementById('pauseBtn').addEventListener('click', pauseSimulation);
            document.getElementById('resetBtn').addEventListener('click', resetSimulation);
            
            const speedSlider = document.getElementById('speedSlider');
            speedSlider.addEventListener('input', (e) => {
                animationSpeed = parseFloat(e.target.value);
                document.getElementById('speedValue').textContent = `${animationSpeed}x`;
            });
        }

        // Start the simulation
        function startSimulation() {
            if (currentIndex >= routeData.length - 1) {
                resetSimulation();
            }
            
            isPlaying = true;
            startTime = Date.now();
            document.getElementById('vehicle-status').textContent = 'Moving';
            document.getElementById('playBtn').disabled = true;
            
            animate();
        }

        // Pause the simulation
        function pauseSimulation() {
            isPlaying = false;
            document.getElementById('vehicle-status').textContent = 'Paused';
            document.getElementById('playBtn').disabled = false;
            
            if (animationId) {
                cancelAnimationFrame(animationId);
            }
        }

        // Reset the simulation
        function resetSimulation() {
            isPlaying = false;
            currentIndex = 0;
            startTime = null;
            document.getElementById('vehicle-status').textContent = 'Ready';
            document.getElementById('playBtn').disabled = false;
            
            if (animationId) {
                cancelAnimationFrame(animationId);
            }

            // Reset vehicle position
            vehicleMarker.setLatLng([routeData[0].latitude, routeData[0].longitude]);
            
            // Reset current route polyline
            currentRoutePolyline.setLatLngs([]);
            
            updateUI();
        }

        // Animation loop
        function animate() {
            if (!isPlaying || currentIndex >= routeData.length - 1) {
                if (currentIndex >= routeData.length - 1) {
                    document.getElementById('vehicle-status').textContent = 'Completed';
                    document.getElementById('playBtn').disabled = false;
                }
                return;
            }

            const now = Date.now();
            const elapsed = (now - startTime) * animationSpeed;
            const intervalMs = 2000; // Move every 2 seconds (adjusted by speed)
            
            if (elapsed >= intervalMs * (currentIndex + 1)) {
                currentIndex++;
                
                if (currentIndex < routeData.length) {
                    const currentPoint = routeData[currentIndex];
                    
                    // Update vehicle marker position
                    vehicleMarker.setLatLng([currentPoint.latitude, currentPoint.longitude]);
                    
                    // Update current route polyline
                    const currentRouteCoords = routeData.slice(0, currentIndex + 1)
                        .map(point => [point.latitude, point.longitude]);
                    currentRoutePolyline.setLatLngs(currentRouteCoords);
                    
                    // Calculate and display speed
                    if (currentIndex > 0) {
                        const prevPoint = routeData[currentIndex - 1];
                        const distance = calculateDistance(
                            prevPoint.latitude, prevPoint.longitude,
                            currentPoint.latitude, currentPoint.longitude
                        );
                        const timeInterval = 5; // 5 seconds between points
                        const speed = (distance / timeInterval) * 3.6; // Convert m/s to km/h
                        document.getElementById('currentSpeed').textContent = `${speed.toFixed(1)} km/h`;
                    }
                    
                    updateUI();
                }
            }

            animationId = requestAnimationFrame(animate);
        }

        // Calculate distance between two points (Haversine formula)
        function calculateDistance(lat1, lon1, lat2, lon2) {
            const R = 6371e3; // Earth's radius in meters
            const φ1 = lat1 * Math.PI/180;
            const φ2 = lat2 * Math.PI/180;
            const Δφ = (lat2-lat1) * Math.PI/180;
            const Δλ = (lon2-lon1) * Math.PI/180;

            const a = Math.sin(Δφ/2) * Math.sin(Δφ/2) +
                      Math.cos(φ1) * Math.cos(φ2) *
                      Math.sin(Δλ/2) * Math.sin(Δλ/2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));

            return R * c;
        }

        // Update UI elements
        function updateUI() {
            const currentPoint = routeData[currentIndex];
            
            // Update position info
            document.getElementById('currentPosition').textContent = `${currentIndex + 1} / ${routeData.length}`;
            document.getElementById('currentCoords').textContent = 
                `${currentPoint.latitude.toFixed(6)}, ${currentPoint.longitude.toFixed(6)}`;
            
            // Update progress bar
            const progress = ((currentIndex + 1) / routeData.length) * 100;
            document.getElementById('progressFill').style.width = `${progress}%`;
            
            // Update elapsed time
            if (startTime && isPlaying) {
                const elapsed = Math.floor((Date.now() - startTime) / 1000);
                const minutes = Math.floor(elapsed / 60);
                const seconds = elapsed % 60;
                document.getElementById('elapsedTime').textContent = 
                    `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
            } else if (!isPlaying && currentIndex === 0) {
                document.getElementById('elapsedTime').textContent = '00:00';
                document.getElementById('currentSpeed').textContent = '0 km/h';
            }
        }

        // Configuration change handler
        async function onConfigChange(config) {
            const appTitle = config.app_title || defaultConfig.app_title;
            const vehicleName = config.vehicle_name || defaultConfig.vehicle_name;
            const routeName = config.route_name || defaultConfig.route_name;
            const primaryColor = config.primary_color || defaultConfig.primary_color;
            const surfaceColor = config.surface_color || defaultConfig.surface_color;
            const textColor = config.text_color || defaultConfig.text_color;
            const accentColor = config.accent_color || defaultConfig.accent_color;
            const backgroundColor = config.background_color || defaultConfig.background_color;

            // Update text content
            document.getElementById('app-title').textContent = appTitle;
            document.getElementById('vehicle-name').textContent = vehicleName;
            document.getElementById('route-name').textContent = routeName;

            // Update colors
            document.body.style.background = `linear-gradient(135deg, ${backgroundColor} 0%, ${primaryColor} 100%)`;
            
            // Update header and panel colors
            const header = document.querySelector('.header');
            const controlsPanel = document.querySelector('.controls-panel');
            header.style.background = `rgba(255, 255, 255, 0.95)`;
            controlsPanel.style.background = `rgba(255, 255, 255, 0.95)`;

            // Update button colors
            const playBtn = document.querySelector('.play-btn');
            const resetBtn = document.querySelector('.reset-btn');
            playBtn.style.background = accentColor;
            resetBtn.style.background = primaryColor;

            // Update progress bar color
            const progressFill = document.getElementById('progressFill');
            progressFill.style.background = `linear-gradient(90deg, ${accentColor}, ${primaryColor})`;

            // Update polyline colors if map is initialized
            if (currentRoutePolyline) {
                currentRoutePolyline.setStyle({ color: accentColor });
            }
        }

        // Element SDK implementation
        const element = {
            defaultConfig,
            onConfigChange,
            mapToCapabilities: (config) => ({
                recolorables: [
                    {
                        get: () => config.background_color || defaultConfig.background_color,
                        set: (value) => {
                            config.background_color = value;
                            window.elementSdk.setConfig({ background_color: value });
                        }
                    },
                    {
                        get: () => config.surface_color || defaultConfig.surface_color,
                        set: (value) => {
                            config.surface_color = value;
                            window.elementSdk.setConfig({ surface_color: value });
                        }
                    },
                    {
                        get: () => config.text_color || defaultConfig.text_color,
                        set: (value) => {
                            config.text_color = value;
                            window.elementSdk.setConfig({ text_color: value });
                        }
                    },
                    {
                        get: () => config.primary_color || defaultConfig.primary_color,
                        set: (value) => {
                            config.primary_color = value;
                            window.elementSdk.setConfig({ primary_color: value });
                        }
                    },
                    {
                        get: () => config.accent_color || defaultConfig.accent_color,
                        set: (value) => {
                            config.accent_color = value;
                            window.elementSdk.setConfig({ accent_color: value });
                        }
                    }
                ],
                borderables: [],
                fontEditable: undefined,
                fontSizeable: undefined
            }),
            mapToEditPanelValues: (config) => new Map([
                ["app_title", config.app_title || defaultConfig.app_title],
                ["vehicle_name", config.vehicle_name || defaultConfig.vehicle_name],
                ["route_name", config.route_name || defaultConfig.route_name]
            ])
        };

        // Initialize everything when page loads
        document.addEventListener('DOMContentLoaded', () => {
            initializeApp();
            
            // Initialize Element SDK if available
            if (window.elementSdk) {
                window.elementSdk.init(element);
            }
        });
    </script>
